# Vylino Business OS — crm.vylino.com
# Owner: Archana Yadav
# Hostinger account email: thevylinoteam@gmail.com

VYLINO_IMAGE=vylino-crm:release
PG_DATABASE_USER=postgres
PG_DATABASE_NAME=vylino
PG_DATABASE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Generate separately with: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_SECRET
APP_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
FALLBACK_ENCRYPTION_KEY=

# Launch-safe defaults. Enable only after smoke tests.
VYLINO_WHATSAPP_ENABLED=false
VYLINO_MARKETING_SYNC_ENABLED=false
VYLINO_WRITE_ATTRIBUTION_FIELDS=false

# Create random values before enabling the related endpoints.
VYLINO_INGEST_SHARED_SECRET=
VYLINO_MARKETING_SYNC_SHARED_SECRET=

# Configure after the production Twenty workspace/API key is created.
VYLINO_TWENTY_GRAPHQL_URL=http://server:3000/graphql
VYLINO_TWENTY_API_KEY=

# WhatsApp — leave empty for first base-CRM launch.
VYLINO_WHATSAPP_PROVIDER=meta
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# Cashfree — start in sandbox after WhatsApp is validated.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
